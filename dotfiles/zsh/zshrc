# managed-by: arch-niri-setup

# Completion. zsh-completions ships its functions outside the default fpath,
# and compinit must run before the interactive plugins wrap completion widgets.
fpath=(/usr/share/zsh/plugins/zsh-completions $fpath)
autoload -Uz compinit
compinit

# Starship prompt.
eval "$(starship init zsh)"

# Autosuggestions from the official repositories.
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS

alias ls='ls --color=auto'
alias ll='ls -lah'
alias pacs='pacman -Ss'
alias paci='sudo pacman -S'
alias pacu='sudo pacman -Syu'
alias paru-update='paru -Syu'
alias paru-clean='paru -Sc'

# Syntax highlighting must be sourced last; it wraps the ZLE widgets above.
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
