#!/usr/bin/env python3
# managed-by: arch-niri-setup
"""Generate a desktop theme from a wallpaper.

Usage:
    theme-from-wallpaper /path/to/wallpaper.jpg [--no-reload]
    theme-from-wallpaper /path/to/wallpaper.jpg --print-palette

The script extracts a dark background, a light foreground and a vivid accent
from the image, renders the templates in ~/.config/arch-niri-setup/templates,
and writes the generated configs for Waybar, mako, Fuzzel, Alacritty and niri.

Generated files are intentionally overwritten on every run. Edit the templates
in the repository (dotfiles/theme/templates) instead of the deployed files.
"""

from __future__ import annotations

import argparse
import colorsys
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

from PIL import Image, ImageOps

HOME = Path.home()
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
XDG_STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
CONFIG_DIR = XDG_CONFIG / "arch-niri-setup"
RENDERED_DIR = CONFIG_DIR / "rendered"
TEMPLATE_DIR = Path(os.environ.get("THEME_TEMPLATE_DIR", CONFIG_DIR / "templates"))
STATE_DIR = XDG_STATE / "arch-niri-setup"


def clamp(value: float, low: float = 0.0, high: float = 1.0) -> float:
    return max(low, min(high, value))


def hex_to_rgb(value: str) -> tuple[int, int, int]:
    value = value.lstrip("#")
    return tuple(int(value[i : i + 2], 16) for i in (0, 2, 4))  # type: ignore[return-value]


def rgb_to_hex(rgb: tuple[float, float, float]) -> str:
    r, g, b = (max(0, min(255, round(c))) for c in rgb)
    return f"#{r:02x}{g:02x}{b:02x}"


def hsv_to_hex(h: float, s: float, v: float) -> str:
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, clamp(s), clamp(v))
    return rgb_to_hex((r * 255, g * 255, b * 255))


def rgb_string(value: str) -> str:
    r, g, b = hex_to_rgb(value)
    return f"{r}, {g}, {b}"


def relative_luminance(rgb: tuple[int, int, int]) -> float:
    def channel(c: int) -> float:
        c = c / 255.0
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4

    r, g, b = (channel(c) for c in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a: str, b: str) -> float:
    la = relative_luminance(hex_to_rgb(a))
    lb = relative_luminance(hex_to_rgb(b))
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def hue_distance(a: float, b: float) -> float:
    d = abs(a - b) % 1.0
    return min(d, 1.0 - d)


def load_entries(path: Path) -> list[dict]:
    with Image.open(path) as image:
        image = ImageOps.exif_transpose(image).convert("RGB")
        image.thumbnail((240, 240), Image.Resampling.LANCZOS)

    quantized = image.quantize(colors=24, method=Image.Quantize.MEDIANCUT)
    palette = quantized.getpalette()
    if palette is None:
        raise SystemExit(f"Could not read palette from {path}")

    entries: list[dict] = []
    for count, index in quantized.getcolors():
        r, g, b = palette[index * 3 : index * 3 + 3]
        h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
        entries.append(
            {
                "count": count,
                "rgb": (r, g, b),
                "h": h,
                "s": s,
                "v": v,
            }
        )

    if not entries:
        raise SystemExit(f"No colors found in {path}")
    return entries


def average_hue(entries: list[dict]) -> tuple[float, float]:
    pool = [e for e in entries if e["s"] > 0.12 and e["v"] > 0.05] or entries
    total = sum(e["count"] for e in pool)
    x = sum(e["count"] * e["s"] * math.cos(2 * math.pi * e["h"]) for e in pool)
    y = sum(e["count"] * e["s"] * math.sin(2 * math.pi * e["h"]) for e in pool)
    if abs(x) + abs(y) < 1e-9:
        hue = max(pool, key=lambda e: e["count"])["h"]
    else:
        hue = (math.atan2(y, x) / (2 * math.pi)) % 1.0
    saturation = sum(e["count"] * e["s"] for e in pool) / total if total else 0.2
    return hue, saturation


def pick_accent(entries: list[dict]) -> dict:
    total = sum(e["count"] for e in entries)
    candidates = [
        e
        for e in entries
        if e["s"] > 0.25
        and 0.15 < e["v"] < 0.95
        and e["count"] > total * 0.0005
    ]
    if not candidates:
        candidates = entries

    best = max(
        candidates,
        key=lambda e: e["count"] * (e["s"] ** 1.4) * (0.4 + e["v"]),
    )

    # Blend the hue of the prominent colorful clusters instead of taking a
    # single pixel cluster. This keeps the accent close to the wallpaper's
    # overall tone (e.g. golden forest -> amber, blue forest -> blue/teal)
    # while still using the strongest cluster for saturation.
    weight_sum = sum(e["count"] * e["s"] for e in candidates)
    if weight_sum <= 0:
        return dict(best)

    x = sum(e["count"] * e["s"] * math.cos(2 * math.pi * e["h"]) for e in candidates)
    y = sum(e["count"] * e["s"] * math.sin(2 * math.pi * e["h"]) for e in candidates)
    hue = (math.atan2(y, x) / (2 * math.pi)) % 1.0 if abs(x) + abs(y) > 1e-9 else best["h"]
    saturation = sum(e["count"] * e["s"] * e["s"] for e in candidates) / weight_sum
    value = sum(e["count"] * e["s"] * e["v"] for e in candidates) / weight_sum

    return {
        "count": sum(e["count"] for e in candidates),
        "rgb": best["rgb"],
        "h": hue,
        "s": max(saturation, best["s"] * 0.90),
        "v": max(value, best["v"]),
    }


def pick_secondary(entries: list[dict], accent_hue: float) -> dict | None:
    total = sum(e["count"] for e in entries)
    candidates = [
        e
        for e in entries
        if e["s"] > 0.30
        and 0.18 < e["v"] < 0.95
        and hue_distance(e["h"], accent_hue) > 0.12
        and e["count"] > total * 0.0003
    ]
    if not candidates:
        return None
    return max(candidates, key=lambda e: e["count"] * (e["s"] ** 1.2))


def accent_name(hue: float) -> str:
    if hue < 0.03 or hue >= 0.95:
        return "red"
    if hue < 0.12:
        return "orange"
    if hue < 0.20:
        return "yellow"
    if hue < 0.42:
        return "green"
    if hue < 0.52:
        return "teal"
    if hue < 0.70:
        return "blue"
    if hue < 0.83:
        return "purple"
    return "pink"


def build_palette(entries: list[dict]) -> tuple[dict[str, str], dict]:
    bg_hue, bg_sat = average_hue(entries)
    bg_sat = clamp(bg_sat * 0.55, 0.06, 0.22)

    # Softer, lighter surfaces than the first version. Pure near-black feels
    # heavy; a slightly raised value keeps the glass tint readable while still
    # letting the wallpaper show through the alpha layers.
    bg = hsv_to_hex(bg_hue, bg_sat, 0.13)
    surface = hsv_to_hex(bg_hue, bg_sat, 0.18)
    fg = hsv_to_hex(bg_hue, 0.05, 0.94)
    fg_bright = hsv_to_hex(bg_hue, 0.03, 0.99)
    muted = hsv_to_hex(bg_hue, 0.08, 0.68)

    accent_entry = pick_accent(entries)
    accent = hsv_to_hex(
        accent_entry["h"],
        clamp(accent_entry["s"], 0.50, 0.72),
        clamp(accent_entry["v"], 0.74, 0.84),
    )

    secondary = pick_secondary(entries, accent_entry["h"])
    if secondary:
        urgent = hsv_to_hex(
            secondary["h"],
            clamp(secondary["s"], 0.45, 0.65),
            clamp(secondary["v"], 0.72, 0.82),
        )
    else:
        urgent = hsv_to_hex(accent_entry["h"] + 0.5, 0.52, 0.76)

    # Keep text readable even on unusually bright/dark wallpapers.
    if contrast(fg, bg) < 7.0:
        fg = "#f2f2f2"
        fg_bright = "#ffffff"
    if contrast(accent, bg) < 3.0:
        accent = hsv_to_hex(accent_entry["h"], 0.70, 0.85)

    palette = {
        "bg": bg,
        "bg_nohash": bg.lstrip("#"),
        "bg_rgb": rgb_string(bg),
        "surface": surface,
        "surface_nohash": surface.lstrip("#"),
        "surface_rgb": rgb_string(surface),
        "fg": fg,
        "fg_nohash": fg.lstrip("#"),
        "fg_rgb": rgb_string(fg),
        "fg_bright": fg_bright,
        "fg_bright_nohash": fg_bright.lstrip("#"),
        "muted": muted,
        "accent": accent,
        "accent_nohash": accent.lstrip("#"),
        "accent_rgb": rgb_string(accent),
        "urgent": urgent,
        "border": f"rgba({rgb_string(accent)}, 0.35)",
        "trough": f"rgba({rgb_string(fg)}, 0.22)",
        "accent_alpha": f"rgba({rgb_string(accent)}, 0.18)",
        "accent_name": accent_name(accent_entry["h"]),
    }
    debug = {
        "background_hue": round(bg_hue, 4),
        "background_saturation": round(bg_sat, 4),
        "accent_source": [round(accent_entry["h"], 4), round(accent_entry["s"], 4), round(accent_entry["v"], 4)],
        "urgent_source": None
        if secondary is None
        else [round(secondary["h"], 4), round(secondary["s"], 4), round(secondary["v"], 4)],
        "contrast_fg_bg": round(contrast(fg, bg), 2),
        "contrast_accent_bg": round(contrast(accent, bg), 2),
    }
    return palette, debug


def render(template_name: str, palette: dict[str, str]) -> str:
    path = TEMPLATE_DIR / template_name
    if not path.is_file():
        raise SystemExit(f"Missing template: {path}")
    text = path.read_text(encoding="utf-8")
    for key, value in palette.items():
        text = text.replace("{{" + key + "}}", value)
    if "{{" in text:
        raise SystemExit(f"Unresolved placeholder in {path}")
    return text


def atomic_write(path: Path, text: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    tmp.write_text(text, encoding="utf-8")
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def session_env() -> dict[str, str]:
    env = os.environ.copy()
    runtime = Path(env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    env["XDG_RUNTIME_DIR"] = str(runtime)
    bus = runtime / "bus"
    if bus.exists():
        env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={bus}")
    return env


def run_quiet(cmd: list[str], env: dict[str, str] | None = None) -> None:
    try:
        subprocess.run(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=env,
            timeout=8,
            check=False,
        )
    except Exception:
        pass


def niri_socket(env: dict[str, str]) -> str | None:
    configured = env.get("NIRI_SOCKET")
    if configured and Path(configured).is_socket():
        return configured
    runtime = Path(env["XDG_RUNTIME_DIR"])
    sockets = sorted(runtime.glob("niri.*.sock"))
    return str(sockets[0]) if sockets else None


def reload_components() -> None:
    env = session_env()
    run_quiet(["pkill", "-USR2", "-x", "waybar"])
    run_quiet(["makoctl", "reload"], env)
    socket = niri_socket(env)
    if socket:
        env["NIRI_SOCKET"] = socket
        run_quiet(["niri", "msg", "action", "load-config"], env)


def set_gtk_accent(name: str) -> None:
    env = session_env()
    if not (env.get("DBUS_SESSION_BUS_ADDRESS") or Path(env["XDG_RUNTIME_DIR"], "bus").exists()):
        return
    run_quiet(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark"], env)
    run_quiet(["gsettings", "set", "org.gnome.desktop.interface", "accent-color", name], env)


def validate_fuzzel(text: str) -> None:
    fuzzel = shutil.which("fuzzel")
    if not fuzzel:
        return
    tmp = RENDERED_DIR / "fuzzel-check.ini"
    atomic_write(tmp, text)
    env = os.environ.copy()
    env["LC_ALL"] = "C.UTF-8"
    result = subprocess.run(
        [fuzzel, "--check-config", "--config", str(tmp)],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    tmp.unlink(missing_ok=True)
    if result.returncode != 0:
        raise SystemExit(f"Fuzzel rejected the generated config:\n{result.stderr}")


def validate_niri(text: str) -> None:
    niri = shutil.which("niri")
    if not niri:
        return
    # The niri config may include relative files (e.g. monitor.kdl written by
    # nwg-displays). Validate in a temp dir that mirrors those includes.
    niri_dir = XDG_CONFIG / "niri"
    with tempfile.TemporaryDirectory(prefix="niri-theme-") as tmpdir:
        tmp = Path(tmpdir) / "config.kdl"
        tmp.write_text(text, encoding="utf-8")
        for extra in niri_dir.glob("*.kdl"):
            if extra.name != "config.kdl":
                shutil.copy2(extra, Path(tmpdir) / extra.name)
        result = subprocess.run(
            [niri, "validate", "-c", str(tmp)],
            capture_output=True,
            text=True,
            check=False,
        )
    if result.returncode != 0:
        raise SystemExit(f"niri rejected the generated config:\n{result.stderr}")


def deploy_theme(image: Path, no_reload: bool) -> None:
    entries = load_entries(image)
    palette, debug = build_palette(entries)

    RENDERED_DIR.mkdir(parents=True, exist_ok=True)
    STATE_DIR.mkdir(parents=True, exist_ok=True)

    waybar = render("waybar-style.css", palette)
    mako = render("mako-config", palette)
    fuzzel = render("fuzzel.ini", palette)
    alacritty = render("alacritty.toml", palette)
    tomllib.loads(alacritty)
    validate_fuzzel(fuzzel)

    atomic_write(RENDERED_DIR / "waybar-style.css", waybar)
    atomic_write(RENDERED_DIR / "mako-config", mako)
    atomic_write(RENDERED_DIR / "fuzzel.ini", fuzzel)
    atomic_write(RENDERED_DIR / "alacritty.toml", alacritty)

    targets = [
        (XDG_CONFIG / "waybar" / "style.css", waybar),
        (XDG_CONFIG / "mako" / "config", mako),
        (XDG_CONFIG / "fuzzel" / "fuzzel.ini", fuzzel),
        (XDG_CONFIG / "alacritty" / "alacritty.toml", alacritty),
    ]
    for target, text in targets:
        if target.parent.is_dir():
            atomic_write(target, text)
        else:
            print(f"warning: {target.parent} does not exist; skipped", file=sys.stderr)

    niri_config = XDG_CONFIG / "niri" / "config.kdl"
    if niri_config.is_file():
        niri_text = niri_config.read_text(encoding="utf-8")
        niri_text, active = re.subn(
            r'(active-color\s+)"#[0-9a-fA-F]{6}"',
            rf'\1"{palette["accent"]}"',
            niri_text,
        )
        niri_text, inactive = re.subn(
            r'(inactive-color\s+)"#[0-9a-fA-F]{6}"',
            rf'\1"{palette["surface"]}"',
            niri_text,
        )
        niri_text, urgent = re.subn(
            r'(urgent-color\s+)"#[0-9a-fA-F]{6}"',
            rf'\1"{palette["urgent"]}"',
            niri_text,
        )
        if active and inactive and urgent:
            validate_niri(niri_text)
            atomic_write(RENDERED_DIR / "niri-config.kdl", niri_text)
            atomic_write(niri_config, niri_text)
        else:
            print(
                f"warning: niri color markers not found (active={active}, inactive={inactive}, urgent={urgent})",
                file=sys.stderr,
            )
    else:
        print(f"warning: {niri_config} does not exist; niri colors not applied", file=sys.stderr)

    env_lines = [
        f'WALLPAPER="{image}"',
        f"THEME_BG={palette['bg']}",
        f"THEME_BG_RGB={palette['bg_rgb']}",
        f"THEME_SURFACE={palette['surface']}",
        f"THEME_FG={palette['fg']}",
        f"THEME_FG_BRIGHT={palette['fg_bright']}",
        f"THEME_MUTED={palette['muted']}",
        f"THEME_ACCENT={palette['accent']}",
        f"THEME_ACCENT_RGB={palette['accent_rgb']}",
        f"THEME_URGENT={palette['urgent']}",
        f"THEME_ACCENT_NAME={palette['accent_name']}",
    ]
    atomic_write(CONFIG_DIR / "theme.env", "\n".join(env_lines) + "\n")
    atomic_write(CONFIG_DIR / "current-wallpaper", f"{image}\n")

    if not no_reload:
        set_gtk_accent(palette["accent_name"])
        reload_components()

    print(f"wallpaper: {image}")
    print(
        "palette: "
        f"bg={palette['bg']} fg={palette['fg']} "
        f"accent={palette['accent']} urgent={palette['urgent']} "
        f"gtk-accent={palette['accent_name']}"
    )
    print(f"debug: {json.dumps(debug, ensure_ascii=False)}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate a desktop theme from a wallpaper")
    parser.add_argument("image", type=Path, help="path to the wallpaper image")
    parser.add_argument("--no-reload", action="store_true", help="write files but do not reload running apps")
    parser.add_argument("--print-palette", action="store_true", help="print the extracted palette as JSON and exit")
    args = parser.parse_args()

    if not args.image.is_file():
        print(f"error: wallpaper not found: {args.image}", file=sys.stderr)
        return 1

    if args.print_palette:
        palette, debug = build_palette(load_entries(args.image))
        print(json.dumps({"palette": palette, "debug": debug}, indent=2, ensure_ascii=False))
        return 0

    deploy_theme(args.image, args.no_reload)
    return 0


if __name__ == "__main__":
    sys.exit(main())
