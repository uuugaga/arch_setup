#!/usr/bin/env bash
# managed-by: arch-niri-setup
# Pick a random wallpaper from ~/Pictures/Wallpapers and apply it with awww.
set -euo pipefail

WALLPAPER_DIR="${WALLPAPER_DIR:-${HOME}/Pictures/Wallpapers}"

if [[ ! -d "${WALLPAPER_DIR}" ]]; then
  notify-send "Wallpaper" "Directory not found: ${WALLPAPER_DIR}" 2>/dev/null || true
  exit 1
fi

shopt -s nullglob
FILES=(
  "${WALLPAPER_DIR}"/*.jpg
  "${WALLPAPER_DIR}"/*.jpeg
  "${WALLPAPER_DIR}"/*.png
  "${WALLPAPER_DIR}"/*.webp
)
shopt -u nullglob

if [[ "${#FILES[@]}" -eq 0 ]]; then
  notify-send "Wallpaper" "No images in ${WALLPAPER_DIR}" 2>/dev/null || true
  exit 1
fi

CHOICE="${FILES[RANDOM % ${#FILES[@]}]}"

if ! pgrep -x awww-daemon >/dev/null 2>&1; then
  awww-daemon >/dev/null 2>&1 &
  sleep 0.5
fi

awww img "${CHOICE}" --transition-type any --transition-duration 1
notify-send "Wallpaper" "$(basename "${CHOICE}")" 2>/dev/null || true
